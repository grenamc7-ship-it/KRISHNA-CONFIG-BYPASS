rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Payment receipts can be uploaded by authenticated users
    match /payment_receipts/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Public assets (QR codes, logos)
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
