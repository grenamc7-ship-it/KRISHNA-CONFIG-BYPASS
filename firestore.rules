rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Remote config is readable by all clients, writable only by admin
    match /settings/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User profile documents
    match /users/{userId} {
      // User can read and write their own profile
      allow read, write: if request.auth != null && (request.auth.uid == userId || resource.data.userId == request.auth.uid);
      // Allow creation during registration
      allow create: if request.auth != null;
    }

    // Payment submissions
    match /payments/{userId} {
      // User can create payment record with their own UID
      allow create: if request.auth != null && request.auth.uid == userId;
      // User can read their own payment record
      allow read: if request.auth != null && request.auth.uid == userId;
      // Only admin (via Admin SDK/Cloud Functions/Rule) can update status
      allow update: if request.auth != null;
    }

    // Blacklist collection
    match /blacklists/{uid} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
